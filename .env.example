# 네이버 지도 JavaScript API 공개 Client ID
# 브라우저에서 사용하는 값이므로 비밀키는 아니지만, 소스에 직접 하드코딩하지 않습니다.
NAVER_MAPS_CLIENT_ID=

# VWorld API 인증키
# 개별공시지가속성조회 호출에 사용합니다.
VWORLD_API_KEY=

# 로컬에서 VWorld 도메인 제한을 맞춰야 할 때만 사용합니다.
# Vercel에서는 VERCEL_URL을 자동으로 사용합니다.
VWORLD_API_DOMAIN=http://127.0.0.1:4173

# 로컬 법원경매 크롤러 API. Vercel에서는 이 값을 비워두면 스냅샷 파일을 사용합니다.
COURT_AUCTION_API_URL=http://127.0.0.1:8000
# 기본값은 크롤러 DB에 모인 법원 물건 전체를 훑습니다. 활성 물건만 보려면 true로 바꾸세요.
COURT_AUCTION_ACTIVE=all
# 실좌표(지오코딩 완료) 물건만 지도에 올립니다. 좌표 미확보 물건은 제외됩니다.
COURT_AUCTION_REQUIRE_COORDINATES=1

# 이전 공공데이터포털 키 이름도 서버에서 fallback으로 읽습니다.
PUBLIC_DATA_SERVICE_KEY=

# 서울 열린데이터광장: 서울시 부동산 실거래가 정보
SEOUL_REAL_ESTATE_API_KEY=

# 온비드 OpenAPI를 확보한 뒤 넣습니다.
ONBID_SERVICE_KEY=
