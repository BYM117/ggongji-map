# VWorld API 인증키
# 개별공시지가속성조회 호출에 사용합니다.
VWORLD_API_KEY=
VWORLD_API_DOMAIN=http://127.0.0.1:4173

# 로컬 법원경매 크롤러 API
COURT_AUCTION_API_URL=http://127.0.0.1:8000
# Vercel에서 Python 법원 API 없이 data/court-auctions.snapshot.json을 쓰려면 1로 설정합니다.
COURT_AUCTION_USE_SNAPSHOT=0
COURT_AUCTION_SNAPSHOT_PATH=data/court-auctions.snapshot.json
COURT_AUCTION_NUM_OF_ROWS=100
COURT_AUCTION_ACTIVE=true
COURT_AUCTION_SORT=priority_desc
# 예: source=진행&region=서울
COURT_AUCTION_DEFAULT_QUERY=

# 이전 공공데이터포털 키 이름도 서버에서 fallback으로 읽습니다.
PUBLIC_DATA_SERVICE_KEY=

# 서울 열린데이터광장: 서울시 부동산 실거래가 정보
SEOUL_REAL_ESTATE_API_KEY=

# 온비드 OpenAPI를 확보한 뒤 넣습니다.
# 정확한 엔드포인트는 사용 신청한 API 문서의 호출 URL을 넣습니다.
ONBID_API_URL=
ONBID_SERVICE_KEY=
ONBID_SERVICE_KEY_PARAM=serviceKey
ONBID_NUM_OF_ROWS=100
ONBID_MAX_PAGES=1
ONBID_MAX_PROPERTIES=100
# 부동산 물건목록 조회서비스 기본값: 압류재산, 수의계약 불가, 매각
ONBID_DEFAULT_QUERY=resultType=json&prptDivCd=0007&pvctTrgtYn=N&dspsMthodCd=0001
